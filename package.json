{
  "name": "wagering-processor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts",
    "start": "bun dist/main.js",
    "dev": "bun --watch src/main.ts",
    "migrate": "bun src/persistence/migrate.ts up",
    "migrate:down": "bun src/persistence/migrate.ts down",
    "queues": "bun scripts/queues.ts",
    "test": "bun test tests/unit",
    "test:integration": "bun test --timeout 120000 tests/integration",
    "test:system": "bun run build && bun test --timeout 180000 tests/system"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1157.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "pg": "8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "overrides": {
    "multer": "2.5.0",
    "path-to-regexp": "8.4.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "@types/express": "5.0.5",
    "@types/node": "22.18.12",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
